{
  "name": "dsh-web-search-keyless",
  "version": "0.1.0",
  "private": true,
  "description": "DSH plugin: a keyless web-search provider for the ctx.web seam — Bing RSS with a DuckDuckGo Lite fallback. No API key, no model turn, no per-search cost.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.5"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web-search",
    "keyless",
    "bing-rss",
    "duckduckgo"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
